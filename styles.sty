% величина отступа между элементами списка литературы
\setlength{\bibsep}{0pt}

% настройка счётчика и заголовов приложений
\newcounter{appendicesnum}
\newcommand*\makeAdditionTitle[1]{
	\refstepcounter{appendicesnum}
	\label{add:#1}
	\begin{flushright}
		\textbf{ПРИЛОЖЕНИЕ \theappendicesnum{}}
	\end{flushright}
}

% настройка отступов в списках
\setlist[enumerate]{noitemsep,nolistsep}
\setlist[itemize]{noitemsep,nolistsep}

% нумерованный список с кириллическими буквами
\makeatletter
\AddEnumerateCounter{\asbuk}{\russian@alph}{щ}
\makeatother

% стиль подписей рисунков
\DeclareCaptionLabelFormat{fig}{Рисунок #2}
\DeclareCaptionFont{figfont}{\centering\rmfamily}
\captionsetup[figure]{labelformat=fig,labelsep=period,font=figfont}

% стиль подписей таблиц
\DeclareCaptionLabelFormat{table}{Таблица #2}
\DeclareCaptionFont{table}{\centering\rmfamily}
\captionsetup[table]{labelformat=table,labelsep=period,font=table}

% стиль подписей листингов
\DeclareCaptionLabelFormat{lstlisting}{Листинг #2}
\DeclareCaptionFont{lstlisting}{\centering\rmfamily}
\captionsetup[lstlisting]{labelformat=lstlisting,labelsep=period,font=table}

